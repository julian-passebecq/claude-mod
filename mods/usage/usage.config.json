    "duty": { "session": 0.6, "sub-conversation": 0.5, "workflow-agent": 0.5, "subagent": 0.3 },
    "effort_factor": { "low": 0.6, "medium": 1, "high": 1.5, "xhigh": 2, "max": 2.5 },
    "unit_kind": { "session": "main", "sub-conversation": "subconversation", "workflow-agent": "workflow", "subagent": "subagent" },
