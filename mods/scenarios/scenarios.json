{
  "schema": 1,
  "sources": {
    "sub-agents": "https://code.claude.com/docs/en/sub-agents",
    "workflows": "https://code.claude.com/docs/en/workflows",
    "model-config": "https://code.claude.com/docs/en/model-config",
    "costs": "https://code.claude.com/docs/en/costs",
    "agent-teams": "https://code.claude.com/docs/en/agent-teams",
    "mods-reference": "https://code.claude.com/docs/en/plugins/mods/reference"
  },
  "models": {
    "opus": { "label": "Opus 5.5", "id": "claude-opus-5-5" },
    "sonnet": { "label": "Sonnet 5.5", "id": "claude-sonnet-5-5" },
    "haiku": { "label": "Haiku 5.5", "id": "claude-haiku-5-5" },
    "fable": { "label": "Fable", "id": "fable" }
  },
  "efforts": ["low", "medium", "high", "xhigh", "max"],
  "units": {
    "session": { "label": "Session", "how": "the conversation you talk to; model and effort set when it starts", "source": "model-config" },
    "sub-conversation": { "label": "Sub-conversation", "how": "a separate session the lead starts for a lane, with its own model and effort", "source": "model-config" },
    "workflow-agent": { "label": "Workflow agent()", "how": "one agent() of a Workflow script, run in the background", "source": "workflows" },
    "subagent": { "label": "Agent subagent", "how": "one Agent tool call; only its summary comes back", "source": "sub-agents" }
  },
  "snippets": ["prompt", "agent", "workflow", "frontmatter", "env"],
  "limits": [
    { "id": "subagents-concurrent", "text": "20 running subagents per session by default (CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS changes it)", "max": 20, "unit": "subagent", "source": "sub-agents", "verified": true },
    { "id": "workflow-concurrent", "text": "up to 16 Workflow agents at once by default, fewer on fewer CPUs (CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS, 1-256)", "max": 16, "unit": "workflow-agent", "source": "workflows", "verified": true },
    { "id": "workflow-run", "text": "1,000 agents per Workflow run", "unit": "workflow-agent", "source": "workflows", "verified": true },
    { "id": "model-order", "text": "subagent model order: Agent call model, then agent file model, then CLAUDE_CODE_SUBAGENT_MODEL, then the session's model", "source": "sub-agents", "verified": true },
    { "id": "explore-plan", "text": "CLAUDE_CODE_SUBAGENT_MODEL alone does not change the built-in Explore and Plan subagents", "unit": "subagent", "source": "sub-agents", "verified": true },
    { "id": "agent-effort", "text": "the Agent call takes a per-call effort for non-fork subagents (2.1.292+); it beats the agent file", "unit": "subagent", "source": "sub-agents", "verified": true },
    { "id": "effort-env", "text": "CLAUDE_CODE_EFFORT_LEVEL beats every per-agent effort (agent file and Agent call)", "source": "sub-agents", "verified": true },
    { "id": "effort-settings", "text": "effortLevel in settings takes low, medium, high or xhigh; max is for one session only (unless set by the env var)", "source": "model-config", "verified": true },
    { "id": "workflow-effort", "text": "no documented effort option on agent(): put the effort in the agent file", "unit": "workflow-agent", "source": "workflows", "verified": false },
    { "id": "workflow-env", "text": "CLAUDE_CODE_WORKFLOW_SUBAGENT_MODEL is not in the workflows page; workflow agents follow the subagent model order", "unit": "workflow-agent", "source": "workflows", "verified": false },
    { "id": "subconv-effort", "text": "a sub-conversation's effort is at most its parent's", "unit": "sub-conversation", "source": "model-config", "verified": false },
    { "id": "costs-subagents", "text": "every subagent and Workflow agent adds its own requests; pick a smaller model for simple ones (model: haiku)", "source": "costs", "verified": true },
    { "id": "teams", "text": "agent teams are experimental, use about 7x the tokens in plan mode, 3-5 teammates recommended", "source": "agent-teams", "verified": true }
  ],
  "scenarios": [
    {
      "id": "S1",
      "name": "Standard V6",
      "summary": "Default day: Opus medium builds, a fresh Opus high reviews, Sonnet tests and writes, Haiku searches.",
      "escalation": true,
      "caps": { "ci_pipelines": 4, "npm_ci_tsc": 3 },
      "defaults": { "subagent_model": "sonnet", "workflow_model": "sonnet" },
      "roles": [
        { "role": "lead", "label": "Lead", "model": "opus", "effort": "medium", "unit": "session", "max_parallel": 1, "note": "plans and dispatches, never codes" },
        { "role": "coder", "label": "Coders", "model": "opus", "effort": "medium", "unit": "workflow-agent", "max_parallel": 4, "agent": "coder", "note": "one package each, own worktree" },
        { "role": "review", "label": "Review", "model": "opus", "effort": "high", "unit": "subagent", "max_parallel": 4, "agent": "architect", "note": "fresh context, correctness only" },
        { "role": "tests", "label": "Tests", "model": "sonnet", "effort": "medium", "unit": "workflow-agent", "max_parallel": 4, "agent": "tester" },
        { "role": "docs", "label": "Docs", "model": "sonnet", "effort": "low", "unit": "subagent", "max_parallel": 2, "agent": "docs-writer" },
        { "role": "search", "label": "Search", "model": "haiku", "effort": "low", "unit": "subagent", "max_parallel": 5, "agent": "explore-fast", "note": "read-only, <= 10 lines back" }
      ]
    },
    {
      "id": "S2",
      "name": "Économe",
      "summary": "Spend less: Sonnet high codes, Opus medium reviews.",
      "escalation": true,
      "caps": { "ci_pipelines": 4 },
      "defaults": { "subagent_model": "sonnet", "workflow_model": "sonnet" },
      "roles": [
        { "role": "lead", "label": "Lead", "model": "opus", "effort": "medium", "unit": "session", "max_parallel": 1 },
        { "role": "coder", "label": "Coders", "model": "sonnet", "effort": "high", "unit": "workflow-agent", "max_parallel": 4, "agent": "coder", "note": "untried on our packages: measure first" },
        { "role": "review", "label": "Review", "model": "opus", "effort": "medium", "unit": "subagent", "max_parallel": 4, "agent": "architect" },
        { "role": "tests", "label": "Tests", "model": "sonnet", "effort": "low", "unit": "workflow-agent", "max_parallel": 4, "agent": "tester" },
        { "role": "search", "label": "Search", "model": "haiku", "effort": "low", "unit": "subagent", "max_parallel": 5, "agent": "explore-fast" }
      ]
    },
    {
      "id": "S3",
      "name": "Qualité max",
      "summary": "Hard or risky work: Opus xhigh plans, Opus high codes and reviews.",
      "escalation": true,
      "caps": { "ci_pipelines": 4 },
      "defaults": { "subagent_model": "sonnet", "workflow_model": "opus" },
      "roles": [
        { "role": "lead", "label": "Lead", "model": "opus", "effort": "high", "unit": "session", "max_parallel": 1 },
        { "role": "architect", "label": "Architect", "model": "opus", "effort": "xhigh", "unit": "subagent", "max_parallel": 1, "agent": "architect", "note": "before the plan and when a fix failed twice" },
        { "role": "coder", "label": "Coders", "model": "opus", "effort": "high", "unit": "workflow-agent", "max_parallel": 3, "agent": "coder" },
        { "role": "review", "label": "Review", "model": "opus", "effort": "high", "unit": "subagent", "max_parallel": 3, "agent": "architect" },
        { "role": "tests", "label": "Tests", "model": "sonnet", "effort": "medium", "unit": "workflow-agent", "max_parallel": 3, "agent": "tester" }
      ]
    },
    {
      "id": "S4",
      "name": "Nuit",
      "summary": "Like S1, started before bed: one Workflow with its stop conditions, no effort escalation, no timer wake-ups.",
      "escalation": false,
      "caps": { "workflows": 1, "ci_pipelines": 4 },
      "defaults": { "subagent_model": "sonnet", "workflow_model": "sonnet" },
      "roles": [
        { "role": "lead", "label": "Lead", "model": "opus", "effort": "medium", "unit": "session", "max_parallel": 1, "note": "starts the one Workflow, then idles" },
        { "role": "coder", "label": "Coders", "model": "opus", "effort": "medium", "unit": "workflow-agent", "max_parallel": 4, "agent": "coder" },
        { "role": "review", "label": "Review", "model": "opus", "effort": "high", "unit": "workflow-agent", "max_parallel": 4, "agent": "architect", "note": "verify step inside the Workflow" },
        { "role": "tests", "label": "Tests", "model": "sonnet", "effort": "medium", "unit": "workflow-agent", "max_parallel": 4, "agent": "tester" },
        { "role": "search", "label": "Search", "model": "haiku", "effort": "low", "unit": "workflow-agent", "max_parallel": 4, "agent": "explore-fast" }
      ]
    },
    {
      "id": "S5",
      "name": "Plein régime",
      "summary": "Lots of weekly quota left close to the reset: Opus high/xhigh everywhere, more lanes, as parallel as the PC allows; review by Opus high. The usage mod suggests it, nothing launches it.",
      "escalation": true,
      "caps": { "ci_pipelines": 4, "npm_ci_tsc": 3 },
      "defaults": { "subagent_model": "opus", "workflow_model": "opus" },
      "roles": [
        { "role": "lead", "label": "Lead", "model": "opus", "effort": "xhigh", "unit": "session", "max_parallel": 1, "note": "plans and dispatches more lanes" },
        { "role": "lane", "label": "Lanes", "model": "opus", "effort": "high", "unit": "sub-conversation", "max_parallel": 3, "note": "one package each" },
        { "role": "coder", "label": "Coders", "model": "opus", "effort": "high", "unit": "workflow-agent", "max_parallel": 4, "agent": "coder", "note": "4 = the PC's CI pipeline cap" },
        { "role": "architect", "label": "Architect", "model": "opus", "effort": "xhigh", "unit": "subagent", "max_parallel": 1, "agent": "architect" },
        { "role": "review", "label": "Review", "model": "opus", "effort": "high", "unit": "subagent", "max_parallel": 4, "agent": "architect", "note": "fresh context, correctness only" },
        { "role": "tests", "label": "Tests", "model": "opus", "effort": "high", "unit": "workflow-agent", "max_parallel": 3, "agent": "tester", "note": "3 = the PC's npm ci / tsc cap" },
        { "role": "search", "label": "Search", "model": "opus", "effort": "high", "unit": "subagent", "max_parallel": 4, "agent": "explore-fast" }
      ]
    }
  ]
}
