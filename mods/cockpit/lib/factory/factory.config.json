{
  "_doc": "factory mod settings. Override any key in ~/.claude/effort-board/factory.config.json (deep merge). Dollars are an ESTIMATE from tokens x these rates.",
  "cost_label": "estimation",
  "rates_source": "USD per million tokens. in/out from docs/models/models.json (claude.com/pricing, checked 9 Oct); haiku-5-5 assumed = haiku-4-5. Cache: read 0.1x input, 5-min write 1.25x, 1-hour write 2x.",
  "rates": {
    "claude-fable-5-1": { "in": 10, "out": 50, "cache_read": 1, "cache_write_5m": 12.5, "cache_write_1h": 20 },
    "claude-opus-5-5": { "in": 4, "out": 20, "cache_read": 0.4, "cache_write_5m": 5, "cache_write_1h": 8 },
    "claude-sonnet-5-5": { "in": 2, "out": 10, "cache_read": 0.2, "cache_write_5m": 2.5, "cache_write_1h": 4 },
    "claude-haiku-5-5": { "in": 1, "out": 5, "cache_read": 0.1, "cache_write_5m": 1.25, "cache_write_1h": 2 },
    "fable": { "in": 10, "out": 50, "cache_read": 1, "cache_write_5m": 12.5, "cache_write_1h": 20 },
    "opus": { "in": 5, "out": 25, "cache_read": 0.5, "cache_write_5m": 6.25, "cache_write_1h": 10 },
    "sonnet": { "in": 2, "out": 10, "cache_read": 0.2, "cache_write_5m": 2.5, "cache_write_1h": 4 },
    "haiku": { "in": 1, "out": 5, "cache_read": 0.1, "cache_write_5m": 1.25, "cache_write_1h": 2 },
    "default": { "in": 5, "out": 25, "cache_read": 0.5, "cache_write_5m": 6.25, "cache_write_1h": 10 }
  },
  "context_window": 400000,
  "thresholds": {
    "ctx_warn_pct": 50,
    "ctx_bad_pct": 62.5,
    "handoff_tokens": 250000,
    "readonly_opus_min_calls": 5,
    "readonly_opus_share": 0.8,
    "recent_hours": 36,
    "live_s": 180
  },
  "readonly_agent_types": ["Explore", "explore-fast", "auditor"],
  "readonly_exempt_types": ["architect"],
  "routing_targets": {
    "_doc": "Model share targets (Haiku read-only, Sonnet edits/tests, Opus plans/review/merge) as call shares, today, main + subagents; shown on Mission under screens.labels.share_title ('cibles V6'). Proposed numbers; the PM sets them here.",
    "metric": "calls",
    "opus": { "max": 0.5 },
    "sonnet": { "min": 0.25 },
    "haiku": { "min": 0.15 }
  },
  "architect": {
    "types": ["architect"],
    "reasons": [
      { "label": "error repeats", "match": "twice|failed again|still fail|stuck|repeat" },
      { "label": "before done", "match": "before (it is )?(declared )?done|final review|before merge|declare.{0,20}done|review of [0-9v]|release" },
      { "label": "before plan", "match": "plan|version|design|milestone|architecture" }
    ],
    "fallback": "other"
  },
  "guard_match": "denied|refused|not allowed|permission|blocked by|guard|hook (error|blocked)|rejected",
  "event_count": 15,
  "turn_count": 10,
  "refresh_s": 20,
  "ci_ttl_s": 600,
  "include_cli": false,
  "python": "python",
  "node": "node",
  "colors": {
    "opus": "#d97706",
    "sonnet": "#2563eb",
    "haiku": "#16a34a",
    "fable": "#9333ea",
    "other": "#6b7280",
    "running": "#2563eb",
    "done": "#16a34a",
    "failed": "#dc2626",
    "stopped": "#6b7280",
    "ok": "#16a34a",
    "warn": "#d97706",
    "bad": "#dc2626",
    "architect": "#9333ea",
    "dim": "#6b7280"
  },
  "screens": {
    "_doc": "Side-panel screens (v2). Every key of SCREEN_DEFAULTS in hooks/screens.mjs can be overridden here or in ~/.claude/effort-board/factory.config.json (deep merge): order and enabled list the tabs (mission, focus, arbre, pipeline, quotas, systeme, journal), start is the first tab, labels holds every French text. Minutes unless named _s/_h. quiet_min: a lane with no turn for that long shows as 'Calme' in the Focus timeline. agent_stage maps a running subagent type to a Pipeline stage (heuristic, non vérifié). layout.narrow / wide are pane widths in columns: under narrow the counters go 2 per row, from wide 6 per row and project cards 2 per row.",
    "order": ["mission", "focus", "arbre", "pipeline", "quotas", "systeme", "journal"],
    "enabled": ["mission", "focus", "arbre", "pipeline", "quotas", "systeme", "journal"],
    "start": "mission",
    "recent_events": 12,
    "quiet_min": 30,
    "quiet_max_h": 12,
    "timeline_max": 25,
    "journal_max": 60,
    "pipeline_hours": 24,
    "quotas_refresh_s": 300,
    "system_refresh_s": 10,
    "gpu_every": 6,
    "layout": { "narrow": 70, "wide": 110, "bar_min": 8, "bar_max": 40 },
    "labels": {
      "tabs": { "mission": "Mission", "focus": "Focus", "arbre": "Arbre", "pipeline": "Pipeline", "quotas": "Quotas", "systeme": "Système", "journal": "Journal" },
      "share_title": "Part des modèles aujourd’hui vs cibles V6 ({metric})"
    }
  },
  "waiting": {
    "_doc": "Strip 'Ça t'attend' at the top of /factory. Minutes unless named _s/_h/_days. idle_pr_states among failed, canceled, skipped, conflict, none, manual. session_link: {id} = the app session id (link format non vérifié). notify: one native notification per new row, ever ($.ui.notify, else a toast).",
    "enabled": true,
    "green_min": 30,
    "idle_min": 20,
    "ask_min": 5,
    "julian_max_age_h": 72,
    "idle_pr_states": ["failed", "canceled", "skipped", "conflict"],
    "max_rows": 12,
    "show_children": true,
    "show_archived_children": false,
    "session_link": "claude://claude.ai/epitaxy/{id}",
    "notify": true,
    "notify_kinds": ["green", "ask", "needs", "awaiting", "idle"],
    "notify_existing_on_first_run": false,
    "notify_max_per_scan": 3,
    "notify_keep_days": 14,
    "background_s": 120,
    "pr_ttl_s": 300,
    "pr_max_age_days": 14,
    "pr_max_checks": 25,
    "gitlab_host": "",
    "labels": {
      "title": "Ça t'attend",
      "none": "Rien ne t’attend.",
      "children": "Sous-conversations",
      "since": "depuis",
      "more": "+ {n} autres",
      "open_session": "Ouvrir",
      "kinds": {
        "green": "PR verte",
        "ask": "Question",
        "needs": "Attend Julian",
        "awaiting": "Attend Julian",
        "idle": "Lane à l’arrêt"
      },
      "green": "{pr} verte depuis {age}, pas mergée",
      "ask": "Question en attente : {question}",
      "needs": "Attend Julian : {text}",
      "awaiting": "Interrompue, attend une personne",
      "idle": "Aucun tour depuis {age} alors que {pr} est {state}",
      "states": {
        "failed": "rouge",
        "canceled": "annulée",
        "skipped": "sans pipeline (skipped)",
        "conflict": "en conflit",
        "none": "sans CI",
        "manual": "en attente d’un job manuel"
      },
      "child": {
        "working": "travaille",
        "julian": "attend Julian",
        "blocked": "bloquée",
        "done": "terminée",
        "review": "à relire",
        "idle": "inactive",
        "archived": "archivée"
      },
      "notify_title": "Ça t'attend",
      "notify_more": "{n} autres lignes dans /factory",
      "reviews_error": "PR/MR non lues : {errors}"
    }
  }
}
